# Caddy: HTTPS automatico (certificado Let s Encrypt) para el dominio
# y proxy inverso hacia la API interna. La web de GitHub Pages llama a
# https://jumpernet.duckdns.org/... y aqui la sirve la API. /bajares/*
# sirve los binarios del navegador JumperNAT (statico).
{$DOMINIO} {
	encode gzip
	handle_path /bajares/* {
		root * /srv/bajares
		file_server
	}
	reverse_proxy api:8000
}
