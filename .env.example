# Copiar a .env y rellenar. .env NO se sube a git (esta en .gitignore)

# == Secretos ==
# Clave para firmar los JWT de sesion (generar con: openssl rand -hex 32)
JWT_SECRET=cambiar-este-valor
# Token compartido nodo<->API para los heartbeats (openssl rand -hex 16)
INTERNAL_TOKEN=cambiar-este-valor

# == API ==
# Puertos de escucha del api (Docker la publica solo en 127.0.0.1)
API_PORT=8000
# Segundos sin heartbeat para considerar un nodo caido
UMBRAL_CAIDO_SEG=35
# Intervalo de envio de heartbeat de cada nodo (segundos)
INTERVALO_HB_SEG=10

# == Dominio (Fase 4+) ==
# Dominio del servicio (Caddy pedira el certificado aqui)
DOMINIO=jumpernet.duckdns.org
# Token de DuckDNS para el DNS challenge
DUCKDNS_TOKEN=placeholder

# == Limites de cuenta (Fase 3) ==
MAX_USUARIOS=200

# == CORS (Fase 4+) ==
# Origenes web que pueden llamar a la API desde el navegador
CORS_ORIGINS=https://y0selin.github.io

# == Cifrado en capas (Fase 8) ==
# Secreto compartido entrada<->nodos para cifrar el stream del usuario en los
# saltos (ChaCha20-Poly1305). Si se deja vacio, el circuito funciona en modo
# plano (compatibilidad con las fases 1-2). Generar con: openssl rand -hex 32
CLAVE_SALTOS=cambiar-este-valor
